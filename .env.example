# ============================================================
# DRISHTI — MULTIMODAL TRAFFIC INTELLIGENCE ENVIRONMENT
# Hacktoberfest Hack Day: Asansol x Hacktropica (MLH)
# Challenge: Best Use of Gemma 4 (Google Cloud)
# ============================================================

# MySQL Relational Database Configuration (Optional; automatic fallback to JSON if offline)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sih_traffic_intelligence

# API & Server Configuration
API_PORT=8000
API_HOST=127.0.0.1
CORS_ORIGINS=*

# Google Cloud Gemma 4 Multimodal Intelligence Layer
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model Selection:
# - 'gemma-4-26b-a4b-it' (Recommended: 26B Mixture-of-Experts with 4B active params for low-latency multimodal reasoning)
# - 'gemma-4-31b-it'     (Dense 31B parameter model for deep reasoning)
GEMINI_MODEL=gemma-4-26b-a4b-it

# Execution Backend: 'gemini_api' (hosted high-speed) or 'local_ollama'
GEMMA_BACKEND=gemini_api
GEMMA_THINKING_LEVEL=minimal
